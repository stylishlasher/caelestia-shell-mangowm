pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io

Singleton {
    id: root

    readonly property string configDir: (Quickshell.env("XDG_CONFIG_HOME")
        || (Quickshell.env("HOME") + "/.config")) + "/stylish"
    readonly property string path: configDir + "/settings.json"

    readonly property var data: adapter

    FileView {
        path: root.path
        watchChanges: true
        printErrors: false

        JsonAdapter {
            id: adapter

            // Appearance
            property string themeMode: "dark"          // dark | light
            property bool useMatugen: true             // derive the palette from the wallpaper
            property string matugenScheme: "scheme-tonal-spot"
            property var matugenColors: ({})           // flat dark palette generated by matugen
            property var matugenColorsLight: ({})      // flat light palette generated by matugen
            property string accent: "#cba6f7"          // fallback / manual accent
            property int cornerRadius: 18

            // Bar
            property bool barEnabled: true
            property string barPosition: "top"         // top | bottom
            property int barHeight: 38
            property real barOpacity: 0.72
            property real panelOpacity: 0.94
            property bool showTags: true
            property bool showMedia: true
            property bool showClock: true
            property bool showLanguage: true
            property bool showNetwork: true
            property bool showBluetooth: true
            property bool showVolume: true
            property bool showBattery: true
            property bool showTray: true
            property bool showNotifications: true
            property bool showPower: true
            property bool use24h: true
            property bool showSeconds: false

            // Dock
            property bool dockEnabled: true
            property bool dockAutoHide: false
            property int dockIconSize: 44
            property var pinnedApps: ["com.mitchellh.ghostty", "ski", "firefox"]

            // Weather
            property string weatherCity: "Москва"
            property int weatherRefreshMinutes: 15
            property bool weatherMetric: true

            // Wallpaper
            property string wallpaper: ""
            property string wallpaperDir: "~/Pictures/Wallpapers"

            // Desktop widgets
            property bool showDesktopClock: true
            property bool showDesktopWeather: true
            property bool showDesktopMedia: true
            property string desktopWidgetPosition: "top-right" // top-left | top-right | bottom-left | bottom-right

            // Night light
            property bool nightLightEnabled: false
            property int nightLightTemp: 4500

            // Bar layout / behavior
            property bool barFloating: true
            property int barMargin: 8
            property string barStyle: "pills" // pills | solid
            property bool showActiveWindow: true
            property bool showWorkspaces: true

            // Misc
            property bool notificationsDnd: false
            property bool osdEnabled: true
            property int tagCount: 10
            property int wallpaperTransitionMs: 700
        }
    }
}
